PORT=3002
NODE_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-min-32-chars
PRICING_SERVICE_URL=http://localhost:3003
CARGO_LEDGER_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3004
# Shared secret for internal service-to-service calls (must match pricing/payment).
INTERNAL_SERVICE_SECRET=
MSG91_AUTH_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_MAPS_API_KEY=

# --- bt-tracking-service (D-014) ---
# Where to hand each accepted GPS fix for geofence/alert/telemetry evaluation. Fire-and-forget:
# when unset, ingestion works exactly as before and only derived data is skipped.
TRACKING_SERVICE_URL=http://localhost:3006
# ── Email notifications (migration 021) ──────────────────────────────────────
# This service hosts the notification outbox + dispatcher for the whole platform.
# Async transactional mail (auctions, trip lifecycle, payments, fleet invites) is
# queued to notification_outbox and drained here. Login/POD OTPs are NOT in scope —
# those stay synchronous inline sends in bt-auth-service / bt-cargo-ledger.
#
# SMTP: the same variable names bt-auth-service and bt-cargo-ledger already use, so
# there is ONE mail config to operate. Leave SMTP_USER blank (or EMAIL_DEV_MODE=true)
# in local dev and the dispatcher logs mail to stdout instead of sending it.
# GET /health reports "email":"smtp" vs "console" so a mis-set prod value is visible.
#
# NOTE ON THE PROVIDER: smtp.gmail.com caps at ~500 recipients/day and refuses to
# send as an unverified From. That is enough for the pilot and NOT enough for
# auction-scale fan-out. Swapping to SES/Postmark/Resend is a change to these four
# values only — no code or template changes.
EMAIL_DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public base URLs of the two apps, used to deep-link from an email into the booking
# it is about. Unset => the email still sends, just without a call-to-action button.
SHIPPER_APP_BASE_URL=http://localhost:3000
DRIVER_APP_BASE_URL=http://localhost:3001

# Public base URL of THIS service as reachable from the internet (through the
# gateway), used to build one-click unsubscribe links. Unset => optional mail sends
# without an unsubscribe footer or List-Unsubscribe header, which measurably raises
# the odds of being marked as spam.
NOTIFICATIONS_PUBLIC_BASE_URL=http://localhost:3002

# In-process outbox drain interval, ms. 0/unset disables it.
#
# LEAVE THIS UNSET ON CLOUD RUN. The container is frozen between requests unless
# CPU-always-allocated is on, so the timer would not reliably fire and the outbox
# would silently fill up. Production drains by Cloud Scheduler POSTing
# /internal/notifications/dispatch every minute. Set it locally for dev.
NOTIFICATIONS_DISPATCH_INTERVAL_MS=

# ── PAN gate (lib/kyc-gate.ts) ───────────────────────────────────────────────────────────────
# PAN is mandatory: posting a load and bidding need a VERIFIED PAN in user_kyc (bt-auth-service
# /kyc/verify/pan). On by default; PAN_GATE=off only for tests and simulations.
# PAN_GATE=on

# ── E-way bills generated on NIC's portal (lib/ewb) ──────────────────────────────────────────
# Generate / update Part B / extend / cancel e-way bills from the app through the GSP (Sandbox),
# in the SHIPPER's name. Needs (1) Sandbox API keys — the same account bt-auth-service uses for
# KYC — and (2) a 32-byte hex key to encrypt each shipper's portal API password at rest. Both
# unset = the feature is off and the app keeps "record a bill generated on the portal".
# Each shipper then adds their e-way bill portal API user (created on ewaybillgst.gov.in with
# "Quicko Infosoft Pvt. Ltd." — Sandbox's company — registered as the GSP) in Settings. Migration 0040
# creates eway_portal_credentials.
#   openssl rand -hex 32   -> EWB_CREDENTIALS_KEY
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
# SANDBOX_BASE_URL=https://api.sandbox.co.in   (test: https://test-api.sandbox.co.in)
EWB_CREDENTIALS_KEY=

# ── Invoice OCR at pickup/drop (POST /bookings/:id/documents/ocr) ─────────────────────────────
# Photograph an invoice with no scannable QR (handwritten/printed) and Document AI reads it to
# PREFILL the freight-documents form — a human still confirms and saves. EITHER processor works:
#   DOCAI_OCR_PROCESSOR_ID     — a plain "Document OCR" processor (the same one bt-auth-service's
#                                document scans use). The page text is read by lib/documents/
#                                invoice-text.ts: transporter consignment notes / LRs (consignor &
#                                consignee GSTINs, invoice no + value, e-way bill no, freight, TO PAY),
#                                GST invoices (CGST/SGST/IGST, HSN/SAC, grand total), plain bills.
#   DOCAI_INVOICE_PROCESSOR_ID — Google's trained Invoice Parser; adds typed entities on top.
# Set one or both. Results are recorded in document_extractions (source='ocr'); OCR runs on the uploaded
# derivative, never the POD original (§5.4). Inert until DOCAI_INVOICE_PROCESSOR_ID is set: with
# it unset, the OCR fallback returns a clean 501 and the QR-scan path is unchanged.
#
# ONE-TIME GCP SETUP (operator):
#   1. Enable the Document AI API on the project.
#   2. Create an **Invoice Parser** processor; copy its ID + region. (This is a SEPARATE processor
#      from bt-fleet-service's Form Parser used for the truck-register bulk import.)
#   3. Grant the bt-booking-service Cloud Run service account "Document AI User"
#      (roles/documentai.apiUser). No key — it uses that identity via the metadata server.
DOCAI_INVOICE_PROCESSOR_ID=
DOCAI_OCR_PROCESSOR_ID=
DOCAI_LOCATION=us
# Project id is read from the metadata server on Cloud Run; set only to override (or in dev).
# GCP_PROJECT_ID=
# Local dev only: paste `gcloud auth print-access-token` to exercise OCR off Cloud Run.
# GCP_ACCESS_TOKEN=

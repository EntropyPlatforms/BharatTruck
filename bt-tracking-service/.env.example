PORT=3006
NODE_ENV=development

# --- Supabase (service-role; reads bookings/drivers, writes trip_routes etc.) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__SUPABASE_SERVICE_ROLE_KEY__

# --- Redis (read-only on loc:* keys; writes trk:* keys) ---
REDIS_URL=redis://localhost:6379

# --- JWT (same secret as the rest of the platform; verifies {userId, role}) ---
JWT_SECRET=__JWT_SECRET__

# --- Google Maps Platform (SERVER key: Routes API + Places API New) ---
# Restricted to Routes API + Places API (New). Keep SECRET. Never expose to browser, never NEXT_PUBLIC, never commit.
GOOGLE_MAPS_SERVER_KEY=AIza__SERVER_KEY_HERE__

# ETA/route cache TTL so we don't hammer Routes API (see cost guardrail #1)
ROUTE_CACHE_TTL_SECONDS=21600

# Fallback diesel price for fuel estimate (editable per request)
DIESEL_PRICE_INR=90

# --- Internal service-to-service auth (D-014) ---
# Same shared secret as the rest of the platform. Guards POST /internal/evaluate, which
# bt-booking-service calls after each accepted GPS fix. The gateway never exposes /internal/*.
INTERNAL_SERVICE_SECRET=__INTERNAL_SERVICE_SECRET__

# Speeding-alert threshold (km/h). NOT a D-012 locked threshold — tunable after the first
# real corridor drive. 80 is the MoRTH ceiling for goods carriages on expressways.
SPEEDING_LIMIT_KMH=80

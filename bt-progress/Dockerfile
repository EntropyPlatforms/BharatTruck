# bt-progress — the client progress portal. Serves the static page (index.html + progress.json,
# generated by build.mjs in the deploy workflow BEFORE this image is built) and the client
# requests page + API (server.mjs). Node built-ins only: nothing to npm install.
# Tickets live in Cloud Storage (TICKETS_BUCKET) behind access codes (PORTAL_CLIENT_CODE /
# PORTAL_TEAM_CODE, from Secret Manager) — set once on the service, kept across deploys.
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY server.mjs ./
COPY lib/ ./lib/
COPY site/ ./site/
USER node
EXPOSE 8080
CMD ["node", "server.mjs"]

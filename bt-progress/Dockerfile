# bt-progress — the client progress portal. Static: index.html + progress.json (generated by
# build.mjs in the deploy workflow BEFORE this image is built). Nothing here talks to any
# BharatTruck service or database; it is a public read-only page.
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY site/ /usr/share/nginx/html/
EXPOSE 8080

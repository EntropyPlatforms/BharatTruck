PORT=3005
NODE_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED — src/lib/redis.ts throws at module load if this is unset, so the
# service will not boot without it (blank value => container exit(1), 503).
REDIS_URL=

# Shared secret for service-to-service calls into bt-booking-service, and that
# service's base URL. Both required: defaultBookingClient() throws without them.
INTERNAL_SERVICE_SECRET=
BOOKING_SERVICE_URL=http://localhost:3002

# Public base URL of the shipper app (hosts the receiver POD page at /pod/:bookingId).
# Threaded into the OTP email as a direct link so the consignee can confirm delivery
# themselves. If unset, the OTP email gracefully falls back to code-only copy.
RECEIVER_APP_BASE_URL=

# --- POD email (SMTP, shared contract with bt-auth-service) ------------------
# Transactional mail goes over SMTP via nodemailer — the same transport and the
# same variable names bt-auth-service uses for login OTPs, so there is one mail
# config to operate across the platform.
#
# Leave SMTP_USER blank (or set EMAIL_DEV_MODE=true) in local dev: the sender
# falls back to ConsoleEmailSender and logs the OTP instead of sending it.
EMAIL_DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional POD-specific From override, used ahead of SMTP_FROM/SMTP_USER. Only
# set this once a verified sending domain exists — Gmail SMTP refuses to send as
# an unverified address, so a made-up value here fails at delivery time.
POD_EMAIL_FROM=

# Optional pepper mixed into the OTP hash before it is stored in Redis. Strongly
# recommended in prod: without it the hash is salted by booking id alone. Changing
# it invalidates every OTP already in flight.
POD_OTP_PEPPER=

# Blockchain (Polygon) — Phase 2
# Leave empty in Phase 1: hashes are computed and stored in DB only
POLYGON_RPC_URL=https://polygon-rpc.com
LEDGER_WALLET_PRIVATE_KEY=
LEDGER_CONTRACT_ADDRESS=

# Phase 1: BLOCKCHAIN_ENABLED=false → hashes stored in DB, not written on-chain
BLOCKCHAIN_ENABLED=false

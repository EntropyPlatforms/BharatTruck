PORT=3003
NODE_ENV=development
JWT_SECRET=change-this-min-32-chars
DIESEL_PRICE_INR=90
# Persistence for the price_quotes lock (source of truth; service-role).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for internal service-to-service calls (must match booking/payment).
INTERNAL_SERVICE_SECRET=

# ── Rate card ────────────────────────────────────────────────────────────────
# The commercial rate is DERIVED from the cost model, not hardcoded:
#   rate_per_km = (diesel/mileage + driver_wage/km + opex/km) * PRICE_MARGIN_MULTIPLE
# so it can never sit below cost, and a DIESEL_PRICE_INR change moves the price
# with it instead of quietly eating the margin.

# Gross margin over operating cost. Default 1.63 is anchored on the founder's real
# HCV numbers (cost ~36/km, market ~60/km): 36.71 * 1.63 = 59.8.
PRICE_MARGIN_MULTIPLE=1.63

# Per-type overrides, INR/km. Set one when you have a real number for that class and
# want it used verbatim instead of computed. Unset = derived (the default, and the
# path that cannot go below cost). Derived values at diesel 90:
#   mini_truck 22 · lcv 28 · hcv 60 · trailer 60
# NOTE: overrides are NOT floored at cost — setting one is a commercial decision the
# platform will not overrule, so check it against the breakdown before shipping it.
# RATE_PER_KM_MINI_TRUCK=
# RATE_PER_KM_LCV=
# RATE_PER_KM_HCV=
# RATE_PER_KM_TRAILER=

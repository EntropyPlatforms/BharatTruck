PORT=3003
NODE_ENV=development
JWT_SECRET=change-this-min-32-chars
DIESEL_PRICE_INR=90
# Persistence for the price_quotes lock (source of truth; service-role).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for internal service-to-service calls (must match booking/payment).
INTERNAL_SERVICE_SECRET=

# ── Price structure (trip-estimate.ts) ─────────────────────────────────────────
# Trip cost = truck running (CV-Parc norms) + driver & helper salary for the trip days
#             + allowance + handling + tolls on the route (axle-scaled).
# Fleet operator estimate  = trip cost × (1 + CARRIER_RETURN_PCT)
# Shipper indicative rate  = fleet operator estimate × MARKET_CORRECTION_FACTOR
CARRIER_RETURN_PCT=0.18
MARKET_CORRECTION_FACTOR=1.05

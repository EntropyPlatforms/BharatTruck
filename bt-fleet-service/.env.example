PORT=3007
NODE_ENV=development
JWT_SECRET=change-this-min-32-chars
# Fleet tenancy, vehicles, assignments and the trip_economics roll-up (service-role).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Live fleet map. Reads the loc:driver:* keys WRITTEN by bt-booking-service ingestion,
# so this must be the SAME Redis instance booking-service uses.
REDIS_URL=redis://localhost:6379
# Shared secret for internal service-to-service calls (must match booking/payment/pricing).
INTERNAL_SERVICE_SECRET=

# D-19 truck schedule: km a loaded truck covers in a day, used to estimate when a
# truck that is out on a trip comes back into the pool. Driving-hour reality plus
# halts, NOT vehicle speed. Unset means 300. This shapes a date shown to a planner
# and nothing else — no assignment is allowed or refused on it — so getting it wrong
# costs a misleading estimate, never a trip that cannot run.
TRUCK_SCHEDULE_KM_PER_DAY=300

# Fleet invite notifications. Invites and their accept/decline answers are posted to
# bt-booking-service's notification outbox (POST /internal/notifications), which owns
# recipient resolution (drivers.id -> users.id -> email) and the dispatcher. Without
# these two values an invite is created but the driver is only told in-app, which is
# how the invite inbox behaved before migration 021.
BOOKING_SERVICE_URL=http://localhost:3002

# Real road distance for the trip P&L roll-up (migration 0034). The roll-up prefers the
# route bt-tracking-service already cached in trip_routes; only when that is absent does it
# ask tracking to compute the distance on demand (POST /internal/route/point, gated by
# INTERNAL_SERVICE_SECRET above). Unset means http://bt-tracking-service:3006. When unset AND
# no cached route exists, the trip falls back to its sold-quote distance — never the old
# haversine × 1.3 estimate, which has been removed.
TRACKING_INTERNAL_URL=http://localhost:3006

# ── Bulk-import OCR (truck register PDF/photo -> vehicle rows) ─────────────────────────────────
# OCR reads a scanned register through Google Document AI and feeds the SAME CSV validator, so a
# scan is an input format, not a second write path. Inert until DOCAI_PROCESSOR_ID is set: with
# it unset, pdf/image uploads return a clean 501 ("export to CSV") and nothing else changes.
#
# ONE-TIME GCP SETUP (operator):
#   1. Enable the Document AI API on the project.
#   2. Create a processor (Form Parser works well for a tabular register); copy its ID + region.
#   3. Grant the bt-fleet-service Cloud Run service account the "Document AI User" role
#      (roles/documentai.apiUser). No key is needed — the service uses that identity via the
#      Cloud Run metadata server.
OCR_PROVIDER=document_ai
DOCAI_PROCESSOR_ID=
DOCAI_LOCATION=us
# Project id is read from the metadata server on Cloud Run; set it only to override (or in dev).
# GCP_PROJECT_ID=
# Local dev only: paste `gcloud auth print-access-token` so OCR can be exercised off Cloud Run.
# GCP_ACCESS_TOKEN=

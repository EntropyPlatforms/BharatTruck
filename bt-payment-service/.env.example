PORT=3004
NODE_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared HS256 secret — must match every other service's JWT_SECRET.
JWT_SECRET=
# Shared secret for service-to-service calls (inbound /internal/* and outbound).
INTERNAL_SERVICE_SECRET=
# bt-booking-service base URL — booking reads + the completed -> paid flip.
BOOKING_SERVICE_URL=
# bt-fleet-service base URL (port 3007). Optional: when unset the per-asset
# trip-economics roll-up is skipped; settlement never depends on it.
FLEET_SERVICE_URL=

# Razorpay — online collection from the shipper (routes/razorpay.ts). Leave KEY_ID and
# KEY_SECRET empty and the feature is OFF: the app keeps the record-a-payment flow.
# rzp_test_… keys run the whole flow without real money. WEBHOOK_SECRET is the secret
# typed into the Razorpay dashboard for <gateway>/api/payments/razorpay/webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

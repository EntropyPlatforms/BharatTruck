# install-links=true makes the @bharattruck/shared `file:` dep install as a COPY
# (not a symlink) under node_modules, so its runtime deps (jsonwebtoken,
# @supabase/supabase-js) hoist into bt-payment-service/node_modules and resolve
# on a fresh `npm ci`. Without this, node resolves the symlink's realpath
# (packages/shared, which has no node_modules on a fresh checkout) and the
# transitive deps are ERR_MODULE_NOT_FOUND. Payment-local; does not touch root/CI.
install-links=true

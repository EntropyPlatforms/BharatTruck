# Shared env template — copy into each service's .env and fill in

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-min-32-chars
JWT_REFRESH_SECRET=change-this-too-min-32-chars

# Auth
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Payment
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications
FIREBASE_SERVICE_ACCOUNT_JSON=

# KYC — identity-document verification (bt-auth-service). Console default (manual review) unless
# a provider + its key are set; see bt-auth-service/.env.example for the full notes. Pick one
# aggregator. KYC does not gate use at MVP (D-5/D-31).
KYC_PROVIDER=console
SUREPASS_API_KEY=
# Sandbox (sandbox.co.in): set KYC_PROVIDER=sandbox and BOTH of these (from console.sandbox.co.in).
SANDBOX_API_KEY=
SANDBOX_API_SECRET=

# Maps
GOOGLE_MAPS_API_KEY=

# Cargo Ledger (Blockchain)
POLYGON_RPC_URL=https://polygon-rpc.com
LEDGER_WALLET_PRIVATE_KEY=
LEDGER_CONTRACT_ADDRESS=

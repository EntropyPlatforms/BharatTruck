# bt-quality — the test portal. Static: index.html + report.json / report.html / report.pdf,
# generated by build.mjs in the "quality" workflow BEFORE this image is built. Nothing here
# talks to any BharatTruck service or database; it is a public read-only page.
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY site/ /usr/share/nginx/html/
EXPOSE 8080
# Cloud Run hands the container PORT=8080; nginx listens there directly.

PORT=3001
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-min-32-chars
JWT_REFRESH_SECRET=change-this-too-min-32-chars

# ── Phone OTP delivery (SMS) ─────────────────────────────────────────────────
# Unset, phone OTPs are printed to the server log and read out from there — which
# is the current pilot behaviour and stays the default. Real SMS is opt-in and
# all-or-nothing: SMS_PROVIDER must name a provider AND every credential that
# provider needs must be set, otherwise the service logs one warning at boot and
# falls back to the console. A half-filled config must not take phone login down.
#
# console | msg91 | twilio. Leave unset for console.
# SMS_PROVIDER=twilio

# MSG91 credentials. THESE CANNOT BE OBTAINED FROM MSG91 ALONE — India's TRAI DLT
# regime gates commercial SMS, and registration takes weeks (docs/BLOCKERS.md B-2):
#   MSG91_AUTH_KEY     — MSG91 account auth key (the only one that is just a dashboard value)
#   MSG91_SENDER_ID    — the 6-char header REGISTERED on the DLT portal, e.g. BHTRUK
#   MSG91_TEMPLATE_ID  — id of a template PRE-APPROVED on DLT. Operators reject any
#                        message whose text does not match an approved template, and a
#                        run of rejections gets the sender header suspended.
# All three must be present or the service stays on the console provider.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=

# Optional. The variable name the approved template exposes for the code — fixed at
# approval time (e.g. "Your BharatTruck code is ##OTP##"), so it must match what was
# registered rather than what we would have picked. Defaults to `otp`.
# MSG91_TEMPLATE_VAR=otp
# Optional. DLT template entity id, echoed on the send when the operator wants it.
# MSG91_DLT_TE_ID=
# Optional. Provider HTTP timeout in ms (shared by every provider, default 8000) and
# MSG91 base URL override.
# SMS_TIMEOUT_MS=8000
# MSG91_BASE_URL=https://control.msg91.com

# Twilio credentials. The account pair comes straight from the Twilio console, but the
# SAME DLT caveat applies as for MSG91 — DLT gates the Indian operator, not the vendor,
# so an unregistered entity/header/template is dropped downstream even with perfectly
# valid Twilio credentials (docs/BLOCKERS.md B-2). When that happens the send fails with
# a Twilio error code in the log rather than silently; until registration completes,
# leave SMS_PROVIDER unset and OTPs keep flowing through the console.
#   TWILIO_ACCOUNT_SID  — account SID, ACxxxxxxxx…
#   TWILIO_AUTH_TOKEN   — auth token for that account (HTTP Basic password)
# Both must be present, PLUS exactly one sender below, or the service stays on console.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# The sender. Set ONE of these. TWILIO_MESSAGING_SERVICE_SID is preferred and wins when
# both are set: a Messaging Service carries the sender pool, geo-permissions and the
# regulatory bundle, which a bare From number does not.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# TWILIO_FROM=+15551234567
# Optional. Twilio API base URL override (regional edge / test double).
# TWILIO_BASE_URL=https://api.twilio.com

# Force the console provider to print the [DEV] form of the OTP line outside
# NODE_ENV=development. Has no effect once a real provider is wired.
# OTP_DEV_MODE=true

# ── KYC / identity-document verification ─────────────────────────────────────
# Unset, identity documents are recorded for MANUAL Ops review, not automatically
# verified — KYC does not gate use at MVP (D-5/D-31), so this is safe as the default.
# Verification is opt-in and all-or-nothing, exactly like SMS above: KYC_PROVIDER must name
# a provider AND its key must be set, or the service falls back to the console provider with
# one boot warning. Pick ONE aggregator — it covers PAN, DL, RC and GSTIN.
#
# console | surepass | sandbox. Leave unset for console.
# KYC_PROVIDER=surepass
# SUREPASS_API_KEY=
# Optional overrides:
# SUREPASS_BASE_URL=https://kyc-api.surepass.io/api/v1
# SUREPASS_TIMEOUT_MS=10000
#
# Sandbox (sandbox.co.in) — two-step auth: the KEY + SECRET mint a 24h access token per call cycle.
# Get BOTH from the Sandbox console (console.sandbox.co.in). KYC_PROVIDER=sandbox needs both set,
# or the service falls back to console with one boot warning.
# KYC_PROVIDER=sandbox
# SANDBOX_API_KEY=
# SANDBOX_API_SECRET=
# Optional overrides (default prod https://api.sandbox.co.in; use the test base while validating):
# SANDBOX_BASE_URL=https://test-api.sandbox.co.in
# SANDBOX_API_VERSION=1.0
# SANDBOX_TIMEOUT_MS=10000
#
# Notes: real Aadhaar OTP eKYC needs an AUA/KUA licence — that is the aggregator's concern,
# and a DigiLocker / offline-XML flow can be slotted in as another provider instead. For bank
# penny-drop, prefer Razorpay/Cashfree (likely already in the payments plan) over a second vendor.
#
# Dev only: auto-pass every verification so the flow is testable without a vendor. Has NO effect
# unless NODE_ENV=development.
# KYC_DEV_MODE=true

# ── Driver-document scan (POST /onboarding/ocr) ──────────────────────────────
# A driver photographs their licence and a cheque/passbook; Google Document AI reads the text and
# the onboarding forms are filled for them to confirm. The photo is not stored. Off until
# DOCAI_OCR_PROCESSOR_ID is set: the app then hides the Scan buttons and forms are typed as before.
# One-time GCP setup: enable the Document AI API, create a "Document OCR" processor, give the
# bt-auth-service service account the "Document AI User" role, and set the processor id here.
# DOCAI_LOCATION must match the processor's region (us or eu).
DOCAI_OCR_PROCESSOR_ID=
DOCAI_LOCATION=us
# Scans allowed per user per window (each scan is a paid OCR call).
# OCR_SCAN_LIMIT=20
# OCR_SCAN_WINDOW_S=3600
# Local dev only: paste `gcloud auth print-access-token` to exercise OCR off Cloud Run.
# GCP_ACCESS_TOKEN=

# Google OAuth (get from Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Password-changed security notice ─────────────────────────────────────────
# After a password reset, this service posts a 'password_changed' event to
# bt-booking-service's notification outbox (POST /internal/notifications). That is
# the email that tells a user their account was taken over — a reset they did not
# request is otherwise invisible to them, since the reset link goes to whoever
# asked for it. Both values must be set for the notice to be sent; unset, the
# reset itself still works and the emit is skipped silently.
BOOKING_SERVICE_URL=http://localhost:3002
INTERNAL_SERVICE_SECRET=

# Email SMTP (for email verification OTPs)
# Works with any SMTP provider: Gmail, SendGrid, AWS SES, Resend, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
EMAIL_DEV_MODE=true

# ── Emailed password-reset link ──────────────────────────────────────────────
# The unified app serves every persona from ONE origin, so a reset link has ONE
# destination. PASSWORD_RESET_URL is that destination: every reset mail lands here
# regardless of the account's role. A callback_url in the request body takes precedence,
# but ONLY if its origin is on the allowlist (see ALLOWED_CALLBACK_ORIGINS below).
#
# Point this at the deployed front-end's reset page, NOT at a stale preview deployment:
# whatever is here is what lands in a real user's inbox.
PASSWORD_RESET_URL=http://localhost:3000/auth/reset

# Pre-config fallback, used ONLY when PASSWORD_RESET_URL is unset — the per-role reset
# pages that shipped before unification, so an environment that has not set the single var
# yet keeps working. An explicit value for the account's role wins; otherwise the mail
# falls back to a localhost dev link. Set PASSWORD_RESET_URL and these can stay unset.
# SHIPPER_RESET_PASSWORD_URL=http://localhost:3000/auth/reset
# DRIVER_RESET_PASSWORD_URL=http://localhost:3002/auth/reset
# FLEET_RESET_PASSWORD_URL=

# ── Consignee claim link (D-35) ──────────────────────────────────────────────
# When booking-service creates a NEW consignee (an unclaimed users row) it calls
# POST /internal/consignee/claim-invite here, and this service emails the receiver a
# single-use claim link. CONSIGNEE_CLAIM_URL is the STANDALONE claim form that link
# points at — deliberately NOT the app's authenticated surface: a consignee joins
# lightly, with no app install and no KYC. Point it at the deployed claim form.
#
# Unset, the link falls back to a visibly-broken localhost dev URL (so a
# misconfigured environment produces an obviously-wrong link, never a silently-wrong
# prod one). The invite itself is emailed via the same SMTP_* config above, and the
# internal endpoint is gated by INTERNAL_SERVICE_SECRET (already set above).
CONSIGNEE_CLAIM_URL=http://localhost:3000/consignee/claim

# ── callback_url allowlist ───────────────────────────────────────────────────
# /auth/forgot-password accepts a callback_url naming the page the emailed link lands on.
# That link carries a REAL single-use reset token, so an unrestricted callback_url lets
# anyone mail a victim's token to a host they own. Only the ORIGINS of the reset URLs
# above are accepted; anything else is a 400.
#
# Optional, comma-separated, for an origin that has no reset var of its own yet. https
# only, except localhost.
# ALLOWED_CALLBACK_ORIGINS=https://app.bharattruck.in,https://staging.bharattruck.in

# ── Auth throttles ───────────────────────────────────────────────────────────
# All optional — the defaults shown are what the service uses when unset. Keyed on
# the EMAIL, never the client IP: `req.ip` here is the bt-gateway container, so an
# IP-keyed limit would put the whole pilot on one counter.

# Wrong passwords tolerated per account before password login is refused. Only
# failures count and a success clears the tally, so a user who knows their password
# is never throttled. A locked account can still get in via magic link.
LOGIN_FAIL_LIMIT=10
LOGIN_FAIL_WINDOW_S=900

# Wrong OTP codes tolerated per address before the live code is burned (forcing a
# fresh, separately-throttled request).
OTP_VERIFY_LIMIT=5

# Messages sent to any one address per window, across every email-producing route.
EMAIL_SEND_LIMIT=5
EMAIL_SEND_WINDOW_S=3600

# Total messages this service may send per UTC day. This is the ceiling that stops a
# quota drain: registration accepts any address, so an attacker spreads sends across
# thousands of addresses and never trips the per-address counter. Raise it before a
# campaign — when it is hit, real users stop receiving verification codes too.
SMTP_DAILY_BUDGET=500
